----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/json",
  "moonbitlang/core/env",
}
----

async fn command(args : Array[String], expected : Int32) -> String {
  let result = @shell.Cmd("moon", args).output()
  guard result.exit_code() == expected else {
    println(result.stdout())
    println(result.stderr())
    fail("unexpected exit from moon " + args.join(" "))
  }
  result.stdout()
}

fn console_text(text : String) -> String {
  text.replace_all(old="\r\n", new="\n")
}

fn html_evidence(html : String) -> Json raise {
  let parts = html.split("<div class=evidence>\n<pre><code>").collect()
  guard parts.length() == 2 else { fail("missing unique HTML evidence") }
  let encoded = parts[1].split("</code></pre>").collect()[0].to_owned()
  let decoded = encoded.replace_all(old="&lt;", new="<").replace_all(old="&gt;", new=">").replace_all(old="&quot;", new="\"").replace_all(old="&#39;", new="'").replace_all(old="&amp;", new="&")
  @json.parse(decoded)
}

fn late_edit(source : String, ending : String) -> String raise {
  guard @json.parse(source) is Object(root) && root["cells"] is Array(cells) && cells[0] is Object(first) && first["source"] is Array(lines) else { fail("unexpected Jupyter fixture shape") }
  let original = StringBuilder()
  for line in lines {
    guard line is String(text) else { fail("unexpected source line") }
    original.write_string(text)
  }
  first["source"] = Json("Shared context\n".repeat(200) + original.to_string() + "\n" + ending)
  Json(root).stringify()
}

fn mime_edit(source : String, result : Int32) -> String raise {
  guard @json.parse(source) is Object(root) && root["cells"] is Array(cells) else { fail("unexpected notebook fixture") }
  let mut found = false
  for cell in cells {
    guard cell is Object(fields) else { fail("invalid fixture cell") }
    if fields.get("cell_type") == Some(Json("code")) {
      let output : Json = {"output_type":"display_data", "metadata":{}, "data":{"text/plain":Json("result: " + result.to_string()), "application/json":{"result":Json(result)}}}
      fields["outputs"] = Json([output])
      found = true
      break
    }
  }
  guard found else { fail("fixture has no code cell") }
  Json(root).stringify()
}

async fn main {
  assert_eq(console_text("a\r\nb\r\nc\r\n"), "a\nb\nc\n")
  assert_eq(console_text("{\"text\":\"a\\r\\nb\\r\\n\"}\r\n"), "{\"text\":\"a\\r\\nb\\r\\n\"}\n")
  let args = @env.args()
  guard args.length() == 1 || args == [args[0], "--portable"] || args == [args[0], "--native"] else { fail("usage: verify.mbtx [--portable|--native]") }
  let targets = if args.length() == 2 && args[1] == "--portable" { ["wasm", "wasm-gc", "js"] } else if args.length() == 2 { ["native"] } else { ["wasm", "wasm-gc", "js", "native"] }
  for path in ["scripts/verify.mbtx", "scripts/prepare-fixture.mbtx", "scripts/verify-git.mbtx"] {
    ignore(command(["fmt", path], 0))
  }
  for args in [["fmt"], ["info"], ["check", "--target", "all", "--deny-warn"]] {
    println(command(args, 0))
  }
  let before = @fs.read_file("fixtures/before.ipynb").text()
  let after = @fs.read_file("fixtures/after.ipynb").text()
  let mut baseline : String? = None
  let mut markdown_baseline : String? = None
  let mut focused_baseline : String? = None
  let mut html_baseline : String? = None
  let mut batch_baseline : String? = None
  let mut mime_baseline : String? = None
  for target in targets {
    println(command(["test", "--target", target, "--deny-warn"], 0))
    if target == "wasm" || target == "native" {
      println(command(["run", "--deny-warn", "scripts/verify-git.mbtx", target], 0))
    }
    let prefix = ["run", "--target", target, "cmd/main", "--"]
    let args = prefix.copy()
    for arg in ["check", "fixtures/before.ipynb", "fixtures/after.ipynb", "--ignore-execution-counts", "--ignore-metadata", "execution"] { args.push(arg) }
    let report_text = command(args, 1)
    let report = @json.parse(report_text[:])
    guard report is Object(fields) && fields["changes"] is Array(changes) && fields["suppressed"] is Array(suppressed) else { fail("invalid report") }
    guard changes.length() == 3 && suppressed.length() == 2 else { fail("real fixture lost expected changes") }
    let normalized_console = console_text(report_text)
    let policy_args = prefix.copy()
    for arg in ["check", "fixtures/before.ipynb", "fixtures/after.ipynb", "--policy", "fixtures/policy.json"] { policy_args.push(arg) }
    assert_eq(console_text(command(policy_args, 1)), normalized_console)
    let mixed = policy_args.copy()
    mixed.push("--ignore-execution-counts")
    ignore(command(mixed, 2))
    let repeated = policy_args.copy()
    repeated.push("--policy")
    repeated.push("fixtures/policy.json")
    ignore(command(repeated, 2))
    let markdown_args = policy_args.copy()
    markdown_args.push("--format")
    markdown_args.push("markdown")
    let markdown = console_text(command(markdown_args, 1))
    guard markdown.contains("Active changes: 3") && markdown.contains("Suppressed changes: 2") else { fail("Markdown lost the real-fixture summary") }
    match markdown_baseline {
      None => markdown_baseline = Some(markdown)
      Some(value) => { assert_eq(markdown, value) }
    }
    let focused_args = markdown_args.copy()
    focused_args.push("--focus-changes")
    let focused = console_text(command(focused_args, 1))
    guard focused.contains("first difference") && focused.contains("Preview range:") else { fail("missing focused preview locations") }
    match focused_baseline {
      None => focused_baseline = Some(focused)
      Some(value) => { assert_eq(focused, value) }
    }
    let duplicate_focus = focused_args.copy()
    duplicate_focus.push("--focus-changes")
    ignore(command(duplicate_focus, 2))
    let json_focus = policy_args.copy()
    json_focus.push("--focus-changes")
    ignore(command(json_focus, 2))
    let invalid_format = policy_args.copy()
    invalid_format.push("--format")
    invalid_format.push("pdf")
    ignore(command(invalid_format, 2))
    let html_args = policy_args.copy()
    for arg in ["--format", "html"] { html_args.push(arg) }
    let html = console_text(command(html_args, 1))
    assert_eq(html_evidence(html), report)
    match html_baseline {
      None => html_baseline = Some(html)
      Some(value) => { assert_eq(html, value) }
    }
    let grouped_html_args = html_args.copy()
    grouped_html_args.push("--group-mime")
    let grouped_html = console_text(command(grouped_html_args, 1))
    assert_eq(html_evidence(grouped_html), report)
    let duplicate_group = grouped_html_args.copy()
    duplicate_group.push("--group-mime")
    ignore(command(duplicate_group, 2))
    let json_group = policy_args.copy()
    json_group.push("--group-mime")
    ignore(command(json_group, 2))
    let invalid_html_focus = html_args.copy()
    invalid_html_focus.push("--focus-changes")
    ignore(command(invalid_html_focus, 2))
    match baseline {
      None => baseline = Some(normalized_console)
      Some(value) => { guard value == normalized_console else { fail("backend report bytes differ") } }
    }
    let same = prefix.copy()
    for arg in ["check", "fixtures/before.ipynb", "fixtures/before.ipynb"] { same.push(arg) }
    ignore(command(same, 0))
    let bundle_args = prefix.copy()
    for arg in ["bundle", "fixtures/before.ipynb", "fixtures/after.ipynb", "--policy", "fixtures/policy.json"] { bundle_args.push(arg) }
    let bundle = command(bundle_args, 0)
    let dir = @fs.tmpdir(prefix="moonnbreview-")
    defer @fs.rmdir(dir, recursive=true)
    let path = dir + "/review.json"
    let batch_prefix = ["run", "--target", target, "cmd/batch", "--"]
    let batch_args = batch_prefix.copy()
    for arg in ["check", "fixtures/manifest.json", "--policy", "fixtures/policy.json"] { batch_args.push(arg) }
    let batch_text = console_text(command(batch_args, 1))
    guard @json.parse(batch_text) is Object(batch) && batch["results"] is Array(batch_items) && batch_items[0] is Object(first_batch) else { fail("invalid batch evidence") }
    assert_eq(first_batch["report"], report)
    assert_eq(batch["summary"], ({"total":2,"passed":1,"blocked":1,"failed":0}:Json))
    match batch_baseline {
      None => batch_baseline = Some(batch_text)
      Some(value) => { assert_eq(batch_text, value) }
    }
    let batch_review = batch_args.copy()
    batch_review[5] = "review"
    assert_eq(console_text(command(batch_review, 0)), batch_text)
    let bad_notebook = dir + "/bad.ipynb"
    let bad_manifest = dir + "/bad-manifest.json"
    @fs.write_file(bad_notebook, "{invalid")
    @fs.write_file(bad_manifest, ({"format":"moonnbreview/manifest-1", "pairs":[
      {"id":"missing","old":Json(dir + "/missing.ipynb"),"new":"fixtures/after.ipynb"},
      {"id":"malformed","old":Json(bad_notebook),"new":"fixtures/after.ipynb"},
      {"id":"healthy","old":"fixtures/before.ipynb","new":"fixtures/before.ipynb"}
    ]}:Json).stringify())
    let batch_errors = batch_prefix.copy()
    for arg in ["check", bad_manifest] { batch_errors.push(arg) }
    guard @json.parse(command(batch_errors, 2)) is Object(errors) && errors["results"] is Array(error_items) else { fail("batch failed to retain diagnostics") }
    assert_eq(error_items.length(), 3)
    assert_eq(errors["summary"], ({"total":3,"passed":1,"blocked":0,"failed":2}:Json))
    batch_errors[5] = "review"
    ignore(command(batch_errors, 2))
    @fs.write_file(bad_manifest, "{}")
    ignore(command(batch_errors, 2))
    @fs.write_file(dir + "/review.html", html)
    assert_eq(console_text(@fs.read_file(dir + "/review.html").text()), html)
    let gate_path = dir + "/gate.json"
    @fs.write_file(gate_path, "{\"format\":\"moonnbreview/gate-1\",\"blocked\":[\"attachment\"]}")
    let batch_gate = batch_args.copy()
    for arg in ["--gate", gate_path] { batch_gate.push(arg) }
    guard @json.parse(command(batch_gate, 0)) is Object(allowed_batch) else { fail("invalid gated batch") }
    assert_eq(allowed_batch["summary"], ({"total":2,"passed":2,"blocked":0,"failed":0}:Json))
    let duplicate_batch_gate = batch_gate.copy()
    for arg in ["--gate", gate_path] { duplicate_batch_gate.push(arg) }
    ignore(command(duplicate_batch_gate, 2))
    batch_gate[5] = "review"
    ignore(command(batch_gate, 2))
    let gated = policy_args.copy()
    for arg in ["--gate", gate_path] { gated.push(arg) }
    assert_eq(console_text(command(gated, 0)), normalized_console)
    let source_gate = policy_args.copy()
    for arg in ["--gate", "fixtures/gate.json"] { source_gate.push(arg) }
    assert_eq(console_text(command(source_gate, 1)), normalized_console)
    let duplicate_gate = source_gate.copy()
    for arg in ["--gate", gate_path] { duplicate_gate.push(arg) }
    ignore(command(duplicate_gate, 2))
    @fs.write_file(gate_path, "{invalid")
    ignore(command(gated, 2))
    let review_gate = source_gate.copy()
    review_gate[5] = "review"
    ignore(command(review_gate, 2))
    let late_before = dir + "/late-before.ipynb"
    let late_after = dir + "/late-after.ipynb"
    @fs.write_file(late_before, late_edit(before, "LATE_EDIT_OLD"))
    @fs.write_file(late_after, late_edit(before, "LATE_EDIT_NEW"))
    let late_args = prefix.copy()
    for arg in ["check", late_before, late_after, "--format", "markdown"] { late_args.push(arg) }
    let late_plain = console_text(command(late_args, 1))
    assert_false(late_plain.contains("LATE_EDIT_NEW"))
    late_args.push("--focus-changes")
    let late_focused = console_text(command(late_args, 1))
    assert_true(late_focused.contains("LATE_EDIT_OLD"))
    assert_true(late_focused.contains("LATE_EDIT_NEW"))
    assert_true(late_focused.contains("units before and 0 after"))
    let mime_before = dir + "/mime-before.ipynb"
    let mime_after = dir + "/mime-after.ipynb"
    @fs.write_file(mime_before, mime_edit(before, 1))
    @fs.write_file(mime_after, mime_edit(before, 2))
    let mime_args = prefix.copy()
    for arg in ["check", mime_before, mime_after, "--format", "html", "--group-mime"] { mime_args.push(arg) }
    let mime_html = console_text(command(mime_args, 1))
    guard mime_html.contains("MIME data key") && mime_html.contains("application/json") && mime_html.contains("text/plain") else { fail("rich fixture lost MIME groups") }
    guard html_evidence(mime_html) is Object(mime_report) && mime_report["changes"] is Array(mime_changes) else { fail("missing MIME evidence") }
    assert_eq(mime_changes.length(), 2)
    match mime_baseline {
      None => mime_baseline = Some(mime_html)
      Some(value) => { assert_eq(mime_html, value) }
    }
    @fs.write_file(path, bundle)
    let replay = prefix.copy()
    replay.push("replay")
    replay.push(path)
    assert_eq(@json.parse(command(replay, 0)[:]), report)
    let html_replay = replay.copy()
    for arg in ["--format", "html"] { html_replay.push(arg) }
    assert_eq(console_text(command(html_replay, 0)), html)
    html_replay.push("--group-mime")
    assert_eq(console_text(command(html_replay, 0)), grouped_html)
    let invalid_gate_replay = replay.copy()
    for arg in ["--gate", "fixtures/gate.json"] { invalid_gate_replay.push(arg) }
    ignore(command(invalid_gate_replay, 2))
    let markdown_replay = replay.copy()
    markdown_replay.push("--format")
    markdown_replay.push("markdown")
    assert_eq(console_text(command(markdown_replay, 0)), markdown)
    let focused_replay = replay.copy()
    for arg in ["--focus-changes", "--format", "markdown"] { focused_replay.push(arg) }
    assert_eq(console_text(command(focused_replay, 0)), focused)
    let invalid_focus_replay = replay.copy()
    invalid_focus_replay.push("--focus-changes")
    ignore(command(invalid_focus_replay, 2))
    let invalid_bundle = bundle_args.copy()
    invalid_bundle.push("--format")
    invalid_bundle.push("markdown")
    ignore(command(invalid_bundle, 2))
    @fs.write_file(path, "{invalid")
    let invalid_policy = prefix.copy()
    for arg in ["check", "fixtures/before.ipynb", "fixtures/before.ipynb", "--policy", path] { invalid_policy.push(arg) }
    ignore(command(invalid_policy, 2))
    let invalid = prefix.copy()
    for arg in ["review", path, "fixtures/before.ipynb"] { invalid.push(arg) }
    ignore(command(invalid, 2))
    println("Executed library and CLI including gate 0/1/2 and bundle replay on " + target)
  }
  assert_eq(@fs.read_file("fixtures/before.ipynb").text(), before)
  assert_eq(@fs.read_file("fixtures/after.ipynb").text(), after)
  println("Verification passed on " + targets.join(", ") + "; source fixtures unchanged.")
}
