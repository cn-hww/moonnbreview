----
import {
  "moonbitlang/async@0.22.4",
  "moonbitlang/async@0.22.4/shell",
  "moonbitlang/async@0.22.4/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

async fn git(dir : String, args : Array[String]) -> String {
  let argv = ["-c", "user.name=cn-hww", "-c", "user.email=292744651+cn-hww@users.noreply.github.com", "-c", "commit.gpgsign=false", "-c", "core.autocrlf=false"]
  for arg in args { argv.push(arg) }
  let result = @shell.Cmd("git", argv, cwd=dir).output()
  result.check()
  result.stdout()
}

async fn cli(target : String, entry : String, args : Array[String], expected : Int32) -> String {
  let argv = ["run", "--deny-warn", "--target", target, entry, "--"]
  for arg in args { argv.push(arg) }
  let result = @shell.Cmd("moon", argv).output()
  guard result.exit_code() == expected else {
    println(result.stdout())
    println(result.stderr())
    fail("unexpected Git workflow exit")
  }
  result.stdout().replace_all(old="\r\n", new="\n")
}

async fn cleanup(dir : String) -> Unit nocancel {
  @async.protect_from_cancel(() => {
    if @env.get_env_var("OS") == Some("Windows_NT") {
      let root = @fs.realpath(dir).replace_all(old="/", new="\\")
      let result = @shell.Cmd("attrib.exe", ["-R", root + "\\.git\\objects\\*", "/S"]).output()
      result.check()
    }
    @fs.rmdir(dir, recursive=true)
  })
}

async fn pipeline(target : String, repo : String, manifest : String, out : String, expected : Int, gate~ : String? = None, old_revision~ : String = "HEAD~1") -> Unit {
  let argv = ["run", "--deny-warn", "scripts/ci-review.mbtx", repo, old_revision, "HEAD", manifest, out, "--policy", "fixtures/policy.json", "--target", target]
  match gate { Some(path) => { argv.push("--gate"); argv.push(path) }; None => () }
  let result = @shell.Cmd("moon", argv).output()
  guard result.exit_code() == expected else {
    println(result.stdout()); println(result.stderr()); fail("unexpected CI pipeline exit")
  }
}

async fn main {
  let args = @env.args()
  guard args.length() == 2 && ["wasm", "native"].contains(args[1]) else { fail("usage: verify-git.mbtx wasm|native") }
  let target = args[1]
  for (entry, version) in [("cmd/git-review", "moonnbreview-git"), ("cmd/git-batch", "moonnbreview-git-batch")] {
    let help = cli(target, entry, ["--help"], 0)
    assert_true(help.contains("Exit:") && help.contains("0.1.0"))
    assert_eq(cli(target, entry, ["-h"], 0), help)
    assert_eq(cli(target, entry, ["--version"], 0), version + " 0.1.0\n")
    ignore(cli(target, entry, ["--version", "extra"], 2))
  }
  let dir = @fs.tmpdir(prefix="nbreview-git-e2e-")
  defer cleanup(dir)
  ignore(git(dir, ["init", "--quiet"]))
  @fs.write_file(dir + "/.gitattributes", "* -text\n")
  @fs.mkdir(dir + "/notebooks")
  let path = "notebooks/课程 [1] $(review).ipynb"
  let before = @fs.read_file("fixtures/before.ipynb").binary()
  let after = @fs.read_file("fixtures/after.ipynb").binary()
  @fs.write_file(dir + "/" + path, before)
  ignore(git(dir, ["add", "--all"]))
  ignore(git(dir, ["commit", "--quiet", "-m", "fixture before"]))
  @fs.write_file(dir + "/" + path, after)
  ignore(git(dir, ["add", "--all"]))
  ignore(git(dir, ["commit", "--quiet", "-m", "fixture after"]))
  @fs.write_file(dir + "/" + path, "staged invalid notebook")
  ignore(git(dir, ["add", "--all"]))
  @fs.write_file(dir + "/" + path, "unstaged invalid notebook")
  let status = git(dir, ["status", "--porcelain=v1"])
  let index = @fs.read_file(dir + "/.git/index").binary()
  let head = git(dir, ["rev-parse", "HEAD"])
  let file_args = ["check", "fixtures/before.ipynb", "fixtures/after.ipynb", "--policy", "fixtures/policy.json"]
  let git_args = ["check", dir, "HEAD~1", "HEAD", path, "--policy", "fixtures/policy.json"]
  assert_eq(cli(target, "cmd/git-review", git_args, 1), cli(target, "cmd/main", file_args, 1))
  let gated_git = git_args.copy()
  let gated_file = file_args.copy()
  for argv in [gated_git, gated_file] { argv.push("--gate"); argv.push("fixtures/gate.json") }
  assert_eq(cli(target, "cmd/git-review", gated_git, 1), cli(target, "cmd/main", gated_file, 1))
  let review = git_args.copy()
  review[0] = "review"
  ignore(cli(target, "cmd/git-review", review, 0))
  for argv in [file_args, git_args] { argv.push("--format"); argv.push("markdown") }
  assert_eq(cli(target, "cmd/git-review", git_args, 1), cli(target, "cmd/main", file_args, 1))
  ignore(cli(target, "cmd/git-review", ["check", dir, "HEAD", "HEAD", path], 0))
  let bundle = cli(target, "cmd/git-review", ["bundle", dir, "HEAD~1", "HEAD", path, "--policy", "fixtures/policy.json"], 0)
  let artifacts = @fs.tmpdir(prefix="nbreview-git-artifacts-")
  defer @fs.rmdir(artifacts, recursive=true)
  let bundle_path = artifacts + "/review.json"
  let manifest_path = artifacts + "/manifest.json"
  let manifest : Json = {"format":"moonnbreview/manifest-1", "pairs":[
    {"id":"first", "old":Json(path), "new":Json(path)},
    {"id":"second", "old":Json(path), "new":Json(path)}
  ]}
  @fs.write_file(manifest_path, manifest.stringify())
  let batch_args = ["check", dir, "HEAD~1", "HEAD", manifest_path, "--policy", "fixtures/policy.json"]
  let batch = cli(target, "cmd/git-batch", batch_args, 1)
  guard @json.parse(batch) is Object(batch_fields) && batch_fields["results"] is Array(entries) && entries.length() == 2 else { fail("missing Git batch evidence") }
  let single = @json.parse(cli(target, "cmd/main", ["check", "fixtures/before.ipynb", "fixtures/after.ipynb", "--policy", "fixtures/policy.json"], 1))
  for entry in entries {
    guard entry is Object(fields) else { fail("invalid batch entry") }
    assert_eq(fields["report"], single)
  }
  let batch_bundle = batch_args.copy()
  batch_bundle[0] = "bundle"
  @fs.write_file(bundle_path, cli(target, "cmd/git-batch", batch_bundle, 0))
  assert_eq(cli(target, "cmd/batch", ["replay", bundle_path], 1), batch)
  let batch_junit = batch_args.copy()
  batch_junit.push("--format"); batch_junit.push("junit")
  assert_eq(cli(target, "cmd/git-batch", batch_junit, 1), cli(target, "cmd/batch", ["replay", bundle_path, "--format", "junit"], 1))
  let batch_markdown = batch_args.copy()
  for arg in ["--format", "markdown", "--focus-changes"] { batch_markdown.push(arg) }
  assert_eq(cli(target, "cmd/git-batch", batch_markdown, 1), cli(target, "cmd/batch", ["replay", bundle_path, "--format", "markdown", "--focus-changes"], 1))
  let captured_dir = artifacts + "/CI artifacts 课程"
  pipeline(target, dir, manifest_path, captured_dir, 1)
  assert_eq(@fs.read_file(captured_dir + "/report.json").text(), batch)
  let allow_gate = artifacts + "/allow-all.json"
  @fs.write_file(allow_gate, "{\"format\":\"moonnbreview/gate-1\",\"blocked\":[]}")
  let passed_dir = artifacts + "/all-passed"
  pipeline(target, dir, manifest_path, passed_dir, 0, gate=Some(allow_gate))
  assert_true(@fs.read_file(passed_dir + "/run.json").text().contains("\"exit_code\":0"))
  let invalid_dir = artifacts + "/invalid-revision"
  pipeline(target, dir, manifest_path, invalid_dir, 2, old_revision="missing-ref")
  assert_false(@fs.exists(invalid_dir))
  assert_eq(@fs.read_file(captured_dir + "/bundle.json").text(), @fs.read_file(bundle_path).text())
  assert_eq(@fs.read_file(captured_dir + "/review.md").text(), cli(target, "cmd/git-batch", batch_markdown, 1))
  assert_eq(@fs.read_file(captured_dir + "/junit.xml").text(), cli(target, "cmd/git-batch", batch_junit, 1))
  let completion = @fs.read_file(captured_dir + "/run.json").text()
  guard @json.parse(completion) is Object(run) && @json.parse(@fs.read_file(captured_dir + "/provenance.json").text()) is Object(provenance) else { fail("missing CI metadata") }
  assert_eq(run["complete"], Json(true)); assert_eq(run["exit_code"], Json(1))
  assert_eq(provenance["old_commit"], Json(git(dir, ["rev-parse", "HEAD~1"]).trim().to_owned()))
  assert_eq(provenance["new_commit"], Json(head.trim().to_owned()))
  pipeline(target, dir, manifest_path, captured_dir, 2)
  assert_eq(@fs.read_file(captured_dir + "/run.json").text(), completion)
  assert_eq(@fs.read_file(captured_dir + "/report.json").text(), batch)
  ignore(cli(target, "cmd/git-batch", ["check", dir, "HEAD", "HEAD", manifest_path], 0))
  let failed_manifest : Json = {"format":"moonnbreview/manifest-1", "pairs":[
    {"id":"missing", "old":"missing.ipynb", "new":Json(path)},
    {"id":"later", "old":Json(path), "new":Json(path)}
  ]}
  @fs.write_file(manifest_path, failed_manifest.stringify())
  let failed = cli(target, "cmd/git-batch", batch_args, 2)
  assert_true(failed.contains("read_old") && failed.contains("\"status\":\"blocked\""))
  let error_dir = artifacts + "/input-errors"
  pipeline(target, dir, manifest_path, error_dir, 2)
  assert_eq(@fs.read_file(error_dir + "/report.json").text(), failed)
  assert_true(@fs.read_file(error_dir + "/run.json").text().contains("\"complete\":true"))
  let unrepresentable : Json = {"format":"moonnbreview/manifest-1", "pairs":[{"id":"bad\uFFFE", "old":Json(path), "new":Json(path)}]}
  @fs.write_file(manifest_path, unrepresentable.stringify())
  let refused_dir = artifacts + "/renderer-refusal"
  pipeline(target, dir, manifest_path, refused_dir, 2)
  assert_false(@fs.exists(refused_dir + "/junit.xml"))
  assert_true(@fs.exists(refused_dir + "/junit.xml.error.txt"))
  assert_true(@fs.exists(refused_dir + "/bundle.json") && @fs.exists(refused_dir + "/report.json") && @fs.exists(refused_dir + "/review.md"))
  guard @json.parse(@fs.read_file(refused_dir + "/run.json").text()) is Object(refusal) else { fail("missing renderer refusal") }
  assert_eq(refusal["gate_exit"], Json(1)); assert_eq(refusal["exit_code"], Json(2))
  @fs.write_file(manifest_path, failed_manifest.stringify())
  for extra in [["--format", "pdf"], ["--format", "json", "--format", "junit"], ["--policy"], ["--unknown", "x"], ["--focus-changes"], ["--format", "markdown", "--focus-changes", "--focus-changes"]] {
    let bad = batch_args.copy()
    for arg in extra { bad.push(arg) }
    ignore(cli(target, "cmd/git-batch", bad, 2))
  }
  let bad_bundle = batch_bundle.copy()
  bad_bundle.push("--format"); bad_bundle.push("json")
  ignore(cli(target, "cmd/git-batch", bad_bundle, 2))
  @fs.write_file(bundle_path, bundle)
  let replay = cli(target, "cmd/main", ["replay", bundle_path, "--format", "markdown"], 0)
  assert_eq(replay, cli(target, "cmd/git-review", git_args, 1))
  let html_git = gated_git.copy()
  let html_file = gated_file.copy()
  for argv in [html_git, html_file] { argv.push("--format"); argv.push("html") }
  let html = cli(target, "cmd/git-review", html_git, 1)
  assert_eq(html, cli(target, "cmd/main", html_file, 1))
  assert_eq(html, cli(target, "cmd/main", ["replay", bundle_path, "--format", "html"], 0))
  for argv in [html_git, html_file] { argv.push("--group-mime") }
  let grouped_html = cli(target, "cmd/git-review", html_git, 1)
  assert_eq(grouped_html, cli(target, "cmd/main", html_file, 1))
  assert_eq(grouped_html, cli(target, "cmd/main", ["replay", bundle_path, "--format", "html", "--group-mime"], 0))
  for argv in [file_args, git_args] { argv.push("--focus-changes") }
  let focused = cli(target, "cmd/git-review", git_args, 1)
  assert_eq(focused, cli(target, "cmd/main", file_args, 1))
  assert_eq(focused, cli(target, "cmd/main", ["replay", bundle_path, "--focus-changes", "--format", "markdown"], 0))
  for argv in [
    ["review", dir, "--help", "HEAD", path],
    ["review", dir, "HEAD", "HEAD", "missing.ipynb"],
    ["review", dir, "HEAD", "HEAD", "../lesson.ipynb"],
    ["review", dir, "HEAD", "HEAD", path, "--format", "pdf"],
    ["review", dir, "HEAD", "HEAD", path, "--format", "html", "--focus-changes"],
    ["review", dir, "HEAD", "HEAD", path, "--group-mime"],
    ["review", dir, "HEAD", "HEAD", path, "--format", "html", "--group-mime", "--group-mime"],
    ["review", dir, "HEAD", "HEAD", path, "--policy", "fixtures/policy.json", "--policy", "fixtures/policy.json"],
    ["review", dir, "HEAD", "HEAD", path, "--ignore-execution-counts"],
    ["bundle", dir, "HEAD", "HEAD", path, "--format", "json"],
    ["review", dir, "HEAD", "HEAD", path, "--focus-changes"],
    ["review", dir, "HEAD", "HEAD", path, "--gate", "fixtures/gate.json"],
    ["check", dir, "HEAD", "HEAD", path, "--gate", "fixtures/gate.json", "--gate", "fixtures/gate.json"],
    ["review", dir, "HEAD", "HEAD", path, "--format", "markdown", "--focus-changes", "--focus-changes"],
  ] { ignore(cli(target, "cmd/git-review", argv, 2)) }
  assert_eq(@fs.read_file(dir + "/" + path).text(), "unstaged invalid notebook")
  assert_eq(@fs.read_file(dir + "/.git/index").binary(), index)
  assert_eq(git(dir, ["status", "--porcelain=v1"]), status)
  assert_eq(git(dir, ["rev-parse", "HEAD"]), head)
  assert_eq(@fs.read_file("fixtures/before.ipynb").binary(), before)
  assert_eq(@fs.read_file("fixtures/after.ipynb").binary(), after)
  // Rename only after the preceding dirty-index/worktree invariants were checked.
  ignore(git(dir, ["restore", "--staged", "--worktree", "--", path]))
  let renamed = "notebooks/改名 [2] $(review).ipynb"
  ignore(git(dir, ["mv", "--", path, renamed]))
  ignore(git(dir, ["commit", "--quiet", "-m", "rename fixture"]))
  let rename_head = git(dir, ["rev-parse", "HEAD"])
  @fs.write_file(dir + "/" + renamed, "dirty renamed notebook")
  let rename_status = git(dir, ["status", "--porcelain=v1"])
  let rename_index = @fs.read_file(dir + "/.git/index").binary()
  let renamed_args = ["check", dir, "HEAD~2", "HEAD", path, "--new-path", renamed, "--policy", "fixtures/policy.json"]
  let expected_json = cli(target, "cmd/main", ["check", "fixtures/before.ipynb", "fixtures/after.ipynb", "--policy", "fixtures/policy.json"], 1)
  assert_eq(cli(target, "cmd/git-review", renamed_args, 1), expected_json)
  ignore(cli(target, "cmd/git-review", ["check", dir, "HEAD~1", "HEAD", path, "--new-path", renamed], 0))
  let renamed_bundle = renamed_args.copy()
  renamed_bundle[0] = "bundle"
  @fs.write_file(bundle_path, cli(target, "cmd/git-review", renamed_bundle, 0))
  assert_eq(cli(target, "cmd/main", ["replay", bundle_path], 0), expected_json)
  for extra in [["--new-path", "../bad"], ["--new-path", ""], ["--new-path", "missing.ipynb"], ["--new-path", renamed, "--new-path", renamed], ["--new-path"]] {
    let bad = ["check", dir, "HEAD~1", "HEAD", path]
    for arg in extra { bad.push(arg) }
    ignore(cli(target, "cmd/git-review", bad, 2))
  }
  ignore(cli(target, "cmd/git-review", ["check", dir, "HEAD~1", "HEAD", path], 2))
  assert_eq(git(dir, ["rev-parse", "HEAD"]), rename_head)
  assert_eq(@fs.read_file(dir + "/.git/index").binary(), rename_index)
  assert_eq(git(dir, ["status", "--porcelain=v1"]), rename_status)
  assert_eq(@fs.read_file(dir + "/" + renamed).text(), "dirty renamed notebook")
  println("Git revision workflow passed on " + target + "; HEAD, index and notebook worktree unchanged.")
}
